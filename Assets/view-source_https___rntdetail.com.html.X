r-only</span>"&gt;</span>: <span class="html-comment">&lt;!-- --&gt;</span>Interior Only<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/label&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;/article&gt;</span><span class="html-tag">&lt;article <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-card</span>"&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-image</span>"&gt;</span><span class="html-tag">&lt;img <span class="html-attribute-name">src</span>="<a class="html-attribute-value html-resource-link" target="_blank" href="https://rntdetail.com/assets/fresh/headlights.jpg" rel="noreferrer noopener">/assets/fresh/headlights.jpg</a>" <span class="html-attribute-name">alt</span>="<span class="html-attribute-value">Illustrative headlight restoration service</span>" <span class="html-attribute-name">width</span>="<span class="html-attribute-value">900</span>" <span class="html-attribute-name">height</span>="<span class="html-attribute-value">600</span>" <span class="html-attribute-name">loading</span>="<span class="html-attribute-value">lazy</span>"/&gt;</span><span class="html-tag">&lt;span&gt;</span>04<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-card-body</span>"&gt;</span><span class="html-tag">&lt;span <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-tag</span>"&gt;</span>Clarity restored<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;h3&gt;</span>Headlight Restoration<span class="html-tag">&lt;/h3&gt;</span><span class="html-tag">&lt;p&gt;</span>Get your foggy headlights restored and brought back to life.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;details&gt;</span><span class="html-tag">&lt;summary&gt;</span>What’s included <span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>+<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/summary&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-inclusions</span>"&gt;</span><span class="html-tag">&lt;p&gt;</span>Care for cloudy headlight lenses to restore a cleaner, clearer appearance. We’ll assess their condition and confirm the scope with your quote.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;/details&gt;</span><span class="html-tag">&lt;label <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-select</span>"&gt;</span><span class="html-tag">&lt;input <span class="html-attribute-name">type</span>="<span class="html-attribute-value">checkbox</span>"/&gt;</span><span class="html-tag">&lt;span&gt;</span>Add to your quote<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;span <span class="html-attribute-name">class</span>="<span class="html-attribute-value">sr-only</span>"&gt;</span>: <span class="html-comment">&lt;!-- --&gt;</span>Headlight Restoration<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/label&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;/article&gt;</span><span class="html-tag">&lt;article <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-card</span>"&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-image</span>"&gt;</span><span class="html-tag">&lt;img <span class="html-attribute-name">src</span>="<a class="html-attribute-value html-resource-link" target="_blank" href="https://rntdetail.com/assets/fresh/polishing.jpg" rel="noreferrer noopener">/assets/fresh/polishing.jpg</a>" <span class="html-attribute-name">alt</span>="<span class="html-attribute-value">Illustrative paint correction service</span>" <span class="html-attribute-name">width</span>="<span class="html-attribute-value">900</span>" <span class="html-attribute-name">height</span>="<span class="html-attribute-value">600</span>" <span class="html-attribute-name">loading</span>="<span class="html-attribute-value">lazy</span>"/&gt;</span><span class="html-tag">&lt;span&gt;</span>05<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-card-body</span>"&gt;</span><span class="html-tag">&lt;span <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-tag</span>"&gt;</span>Gloss, clarity &amp;amp; reflection<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;h3&gt;</span>Paint Correction<span class="html-tag">&lt;/h3&gt;</span><span class="html-tag">&lt;p&gt;</span>Machine polishing tailored to your paintwork for a deep, glossy finish.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;details&gt;</span><span class="html-tag">&lt;summary&gt;</span>What’s included <span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>+<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/summary&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-inclusions</span>"&gt;</span><span class="html-tag">&lt;p&gt;</span>Restore your vehicle’s paintwork and bring back a deep, glossy finish. Our paint correction process carefully removes or significantly reduces surface imperfections such as swirl marks, light scratches, oxidation, water spots, and hazing through machine polishing.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;p&gt;</span>The paint is thoroughly washed and decontaminated before being polished using professional-grade compounds and finishing polishes. The result is a smoother, clearer, deeper-looking finish with dramatically improved gloss and reflections.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;p&gt;</span>Paint correction is performed according to the condition of the vehicle’s paint, with the goal of achieving the best possible finish while safely preserving the factory clear coat.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;/details&gt;</span><span class="html-tag">&lt;label <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-select</span>"&gt;</span><span class="html-tag">&lt;input <span class="html-attribute-name">type</span>="<span class="html-attribute-value">checkbox</span>"/&gt;</span><span class="html-tag">&lt;span&gt;</span>Add to your quote<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;span <span class="html-attribute-name">class</span>="<span class="html-attribute-value">sr-only</span>"&gt;</span>: <span class="html-comment">&lt;!-- --&gt;</span>Paint Correction<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/label&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;/article&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;p <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-image-note</span>"&gt;</span>Service imagery is illustrative. Final scope and pricing are confirmed for your vehicle.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;footer <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-footer</span>"&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">aria-live</span>="<span class="html-attribute-value">polite</span>"&gt;</span><span class="html-tag">&lt;strong&gt;</span>0<span class="html-comment">&lt;!-- --&gt;</span> service<span class="html-comment">&lt;!-- --&gt;</span>s<span class="html-comment">&lt;!-- --&gt;</span> selected<span class="html-tag">&lt;/strong&gt;</span><span class="html-tag">&lt;span&gt;</span>Choose one or combine a few.<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;button <span class="html-attribute-name">type</span>="<span class="html-attribute-value">button</span>" <span class="html-attribute-name">class</span>="<span class="html-attribute-value">picker-done</span>"&gt;</span>Done <span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>↗<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/button&gt;</span><span class="html-tag">&lt;/footer&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;/dialog&gt;</span><span class="html-tag">&lt;/section&gt;</span><span class="html-tag">&lt;/dialog&gt;</span><span class="html-tag">&lt;section <span class="html-attribute-name">class</span>="<span class="html-attribute-value">fresh-section fresh-faq</span>"&gt;</span><span class="html-tag">&lt;h2&gt;</span>A few things<span class="html-tag">&lt;br/&gt;</span>to know.<span class="html-tag">&lt;/h2&gt;</span><span class="html-tag">&lt;div&gt;</span><span class="html-tag">&lt;details&gt;</span><span class="html-tag">&lt;summary&gt;</span>Where do you detail my car?<span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>+<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/summary&gt;</span><span class="html-tag">&lt;p&gt;</span>We come to your home or office. RNTdetail is based in Saratoga, California. Send your location so we can confirm service availability.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;/details&gt;</span><span class="html-tag">&lt;details&gt;</span><span class="html-tag">&lt;summary&gt;</span>How much will it cost?<span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>+<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/summary&gt;</span><span class="html-tag">&lt;p&gt;</span>Every vehicle is different. Tell us its make, model, condition, and the service you need. We will confirm the scope and price before you book.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;/details&gt;</span><span class="html-tag">&lt;details&gt;</span><span class="html-tag">&lt;summary&gt;</span>Do I need to provide anything?<span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>+<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/summary&gt;</span><span class="html-tag">&lt;p&gt;</span>Tell us about parking and access at your location when you request a quote. We will confirm any preparation or requirements before your appointment.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;/details&gt;</span><span class="html-tag">&lt;details&gt;</span><span class="html-tag">&lt;summary&gt;</span>Can I choose a day?<span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>+<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/summary&gt;</span><span class="html-tag">&lt;p&gt;</span>Yes. Include your preferred day in your request. Our listed hours are 7 AM to 8 PM daily. We will confirm availability directly; a quote request is not a reserved appointment.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;/details&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;/section&gt;</span><span class="html-tag">&lt;/main&gt;</span><span class="html-tag">&lt;footer <span class="html-attribute-name">class</span>="<span class="html-attribute-value">fresh-footer</span>"&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">footer-top</span>"&gt;</span><span class="html-tag">&lt;p&gt;</span>Your next clean<span class="html-tag">&lt;br/&gt;</span>starts with hello.<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;a <span class="html-attribute-name">href</span>="<a class="html-attribute-value html-external-link" target="_blank" href="tel:+15103408523" rel="noreferrer noopener">tel:+15103408523</a>"&gt;</span>(510) 340-8523 <span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>↗<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/a&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;div <span class="html-attribute-name">class</span>="<span class="html-attribute-value">footer-information</span>"&gt;</span><span class="html-tag">&lt;div&gt;</span><span class="html-tag">&lt;strong&gt;</span>RNTdetail (Mobile)<span class="html-tag">&lt;/strong&gt;</span><span class="html-tag">&lt;p&gt;</span>18676 Paseo Pueblo<span class="html-tag">&lt;br/&gt;</span>Saratoga, CA 95070<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;a <span class="html-attribute-name">href</span>="<a class="html-attribute-value html-external-link" target="_blank" href="https://www.google.com/maps/search/?api=1&amp;query=RNTdetail%20Mobile%2018676%20Paseo%20Pueblo%20Saratoga%20CA" rel="noreferrer noopener">https://www.google.com/maps/search/?api=1&amp;amp;query=RNTdetail%20Mobile%2018676%20Paseo%20Pueblo%20Saratoga%20CA</a>" <span class="html-attribute-name">target</span>="<span class="html-attribute-value">_blank</span>" <span class="html-attribute-name">rel</span>="<span class="html-attribute-value">noreferrer</span>"&gt;</span>View location <span class="html-tag">&lt;span <span class="html-attribute-name">aria-hidden</span>="<span class="html-attribute-value">true</span>"&gt;</span>↗<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/a&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;div&gt;</span><span class="html-tag">&lt;strong&gt;</span>Come clean, every day.<span class="html-tag">&lt;/strong&gt;</span><span class="html-tag">&lt;p&gt;</span>Monday to Sunday<span class="html-tag">&lt;br/&gt;</span>7 AM to 8 PM<span class="html-tag">&lt;/p&gt;</span><span class="html-tag">&lt;span&gt;</span>Call or text for availability.<span class="html-tag">&lt;/span&gt;</span><span class="html-tag">&lt;/div&gt;</span><span class="html-tag">&lt;div&gt;</span><span class="html-tag">&lt;strong&gt;</span>Made for your driveway.<span class="html-tag">&lt;/strong&gt;</span><span class="html-tag">&lt;a <span class="html-attribute-name">href</span>="<a class="html-attribute-value html-external-link" target="_blank" href="https://rntdetail.com/services/full-detail" rel="noreferrer noopener">/services/full-detail</a>"&gt;</span>Explore services<span class="html-tag">&lt;/a&gt;</span><span class="html-tag">&lt;a <span class="html-attribute-name">href</span>="<a class="html-attribute-value html-external-link" target="_blank" href="https://www.google.com/search?q=RNTdetail+%28Mobile%29" rel="noreferrer noopener">https://www.google.com/search?q=RNTdetail+%28Mobile%29</a>" <span class="html-attribute-name">target</span>="<span class="html-attribute-value">_blank</span>" <span class="html-attribute-name">rel</span>="<span class="html-attribute-value">noreferrer</span>"